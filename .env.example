# Kisan Setu Application Configuration
APP_NAME="Kisan Setu API"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for portability)
DATABASE_URL=sqlite:///./kisan_setu.db

# Authentication / Security
SECRET_KEY=kisan_setu_secret_key_2026_super_secure_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Google Maps Platform Configuration
# 1. Create a Google Cloud Project at https://console.cloud.google.com
# 2. Enable: Maps JavaScript API, Places API (New), Routes API, Geocoding API
# 3. Create an API key under Credentials and restrict by HTTP referrer / API
# 4. Paste your key below (or use the free Maps Demo Key for prototyping):
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ML Configuration
MODEL_DIR=ml/models
DATA_DIR=ml/data
SELECTED_MODEL=xgboost
