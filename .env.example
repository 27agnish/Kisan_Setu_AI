# Kisan Setu Application Configuration
APP_NAME="Kisan Setu API"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# - Local default: sqlite:///./database/kisan_setu.db
# - Vercel Serverless default: automatically uses /tmp/kisan_setu.db (ephemeral, auto-seeded demo)
# - For persistent production database on Vercel, supply a PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./database/kisan_setu.db

# Authentication / Security (Set a strong secret key in production / Vercel Environment Variables)
SECRET_KEY=kisan_setu_secret_key_2026_super_secure_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Google Maps Platform Configuration (Optional)
# If omitted or left empty, the application automatically uses free OpenStreetMap + Leaflet.js
GOOGLE_MAPS_API_KEY=

# ML Configuration
MODEL_DIR=ml/models
DATA_DIR=ml/data
SELECTED_MODEL=xgboost
